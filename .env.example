# Скопируйте этот файл в .env.local и заполните значения.
# Файл .env.local в репозиторий не попадает.

# Адрес формы Formspree (https://formspree.io → New form → Endpoint).
# Пример формата: https://formspree.io/f/xxxxxxxx
# Пока значение пустое, форма на сайте отключена и сообщает об этом.
VITE_FORMSPREE_ENDPOINT=

# Адрес сайта без завершающего слэша — для sitemap.xml и Open Graph.
# На Vercel можно не указывать: адрес проекта подставится автоматически.
# Укажите, когда подключите собственный домен.
VITE_SITE_URL=
